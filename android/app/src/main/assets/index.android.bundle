27\u062f \u0634\u0631\u06a9\u062a\u200c\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u0628\u0647 \u0628\u06cc\u0634\u06cc\u0646\u0647 \u0645\u06cc\u0632\u0627\u0646 \u0645\u062c\u0627\u0632 \u0631\u0633\u06cc\u062f\u0647 \u0627\u0633\u062a",micConstraintFailedError:"\u0645\u06cc\u06a9\u0631\u0648\u0641\u0648\u0646 \u0634\u0645\u0627 \u0628\u0631\u062e\u06cc \u0627\u0632 \u0642\u0627\u0628\u0644\u06cc\u062a\u200c\u0647\u0627\u06cc \u0645\u0648\u0631\u062f \u0646\u06cc\u0627\u0632 \u0631\u0627 \u0646\u062f\u0627\u0631\u062f.",micNotFoundError:"\u0645\u06cc\u06a9\u0631\u0648\u0641\u0646 \u067e\u06cc\u062f\u0627 \u0646\u0634\u062f.",micNotSendingData:"\u0628\u0631\u0627\u06cc \u0631\u0648\u0634\u0646\u200c\u06a9\u0631\u062f\u0646 \u0645\u06cc\u06a9\u0631\u0648\u0641\u0648\u0646 \u062e\u0648\u062f \u0648 \u062a\u0646\u0638\u06cc\u0645 \u0633\u0637\u062d \u0635\u062f\u0627\u06cc \u0622\u0646\u060c \u0628\u0647 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0631\u0627\u06cc\u0627\u0646\u0647\u0654 \u062e\u0648\u062f \u0628\u0631\u0648\u06cc\u062f",micNotSendingDataTitle:"\u0645\u06cc\u06a9\u0631\u0648\u0641\u0646 \u0634\u0645\u0627 \u062a\u0648\u0633\u0637 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0631\u0627\u06cc\u0627\u0646\u0647\u0654 \u0634\u0645\u0627 \u0628\u06cc\u200c\u0635\u062f\u0627 \u0634\u062f\u0647 \u0627\u0633\u062a",micPermissionDeniedError:"\u0634\u0645\u0627 \u0645\u062c\u0648\u0632 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0645\u06cc\u06a9\u0631\u0648\u0641\u0646 \u0631\u0627 \u0646\u062f\u0627\u062f\u0647\u200c\u0627\u06cc\u062f. \u0647\u0645\u0686\u0646\u0627\u0646 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0647 \u06a9\u0646\u0641\u0631\u0627\u0646\u0633 \u0628\u067e\u06cc\u0648\u0646\u062f\u062f\u060c \u0627\u0645\u0627 \u062f\u06cc\u06af\u0631\u0627\u0646 \u0635\u062f\u0627\u06cc \u0634\u0645\u0627 \u0631\u0627 \u0646\u0645\u06cc\u200c\u0634\u0646\u0648\u0646\u062f. \u0628\u0631\u0627\u06cc \u0631\u0641\u0639 \u0627\